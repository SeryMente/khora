{
  "schema": "harmonia.coverage-catalog.v1",
  "version": "0.1.1",
  "reviewedAt": "2026-10-21",
  "title": "Inventario de la superficie conversacional de ChatGPT en Chrome",
  "purpose": "Medir el grado de mapeo de las posibilidades documentadas y de las superficies observadas durante el uso natural. No es un porcentaje de precisión ni de completitud de captura.",
  "scope": {
    "include": [
      "vista principal de conversación",
      "mensajes del usuario y del asistente",
      "compositor y controles inmediatos",
      "estados de generación",
      "bloques y resultados dentro de la conversación",
      "citas y resultados de herramientas visibles en el hilo"
    ],
    "exclude": [
      "Configuración y preferencias de cuenta",
      "menús administrativos y de perfil",
      "inventario completo de la barra lateral",
      "Chrome y sus menús",
      "red interna de la plataforma",
      "razonamiento privado no expuesto por la interfaz"
    ]
  },
  "scoring": {
    "documentationWeight": 1,
    "naturalObservationWeight": 1,
    "formula": "100 * (featuresWithOfficialDocumentation + featuresObservedInNaturalNavigation) / (2 * inScopeFeatures)",
    "interpretation": "Índice de completitud del mapeo, no de la aplicación ni de la calidad de captura. Mostrar además ambos componentes y los elementos pendientes por clasificar."
  },
