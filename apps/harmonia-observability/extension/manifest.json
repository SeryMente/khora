{
  "manifest_version": 3,
  "name": "Harmonia · Observabilidad del trabajo con IA",
  "version": "0.3.0",
  "description": "Mapeo automático y local de estructura y controles de las pestañas de chatgpt.com, sin capturar texto de conversación.",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:47321/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Harmonia · mapeo automático"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
