{
  "manifest_version": 3,
  "name": "Harmonia · Observabilidad del trabajo con IA",
  "version": "0.4.0",
  "description": "Observabilidad local automática y multi-pestaña de ChatGPT: estructura, consola y texto visible de mensajes; no captura borradores ni razonamiento oculto.",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:47321/*",
    "https://raw.githubusercontent.com/SeryMente/khora/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Harmonia · estado y panel"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "region-policy.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
