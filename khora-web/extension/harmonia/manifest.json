{
  "manifest_version": 3,
  "key": "",
  "name": "Aisthesis (Halcon) - CoMind",
  "version": "0.3.3",
  "description": "Sombrilla de integraciones de CoMind. Shell modular MV3: cada integracion (globo, caza, ...) es un modulo enchufable conmutable. Secretos en Ajustes, telemetria -> Logos.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "idle",
    "scripting",
    "nativeMessaging",
    "cookies"
  ],
  "host_permissions": [
    "https://globohq.com/*",
    "https://api.notion.com/*",
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "core/shell.sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "modules/globo/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://globohq.com/*"
      ],
      "js": [
        "modules/globo/mainworld.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://globohq.com/*"
      ],
      "js": [
        "modules/globo/booster.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace/*"
      ],
      "js": [
        "modules/caza/content.js",
        "modules/caza/humano.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "core/aisthesis.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Aisthesis - sombrilla CoMind",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}