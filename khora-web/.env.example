# khora-web · plantilla de entorno. Copiar a .env.local y rellenar desde la boveda.
# Import-KhoraEnvVault vive en scripts/khora/env-vault.ps1

AUTH_SECRET=
DATABASE_URL=
GEMINI_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GROQ_API_KEY=
GROQ_PULIDO_MODEL=
INTERNAL_TRIGGER_SECRET=
JULES_API_KEY=
KHORA_API_KEY=
KHORA_API_URL=
MAX_CONCURRENT_JULES_SESSIONS=
MEDICAL_INTERP_MONTHLY_GOAL=
META_MINUTES_MONTH=
NEO4J_PASSWORD=
NEO4J_URI=
NEO4J_USER=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_ROADMAP_DATABASE_ID=
NOTION_TOKEN=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER_URL=
PLAYWRIGHT_STORAGE_STATE_PATH=
PLAYWRIGHT_TEST_BYPASS=
PLAYWRIGHT_TEST_RUN=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
TODOIST_TOKEN=
VERCEL_ENV=
VERCEL_GIT_COMMIT_REF=
VERCEL_GIT_COMMIT_SHA=
X_KHORA_KEY=

EP_BOOTSTRAP_JWT_SECRET=
EP_CANONICAL_URL=https://khora.example.com/api/ep
EP_ALLOWED_EMAIL=
EP_TOKEN_TTL_SECONDS=43200

# Capacidad de 60 minutos emitida por Khora Web para el agente local.
VAULT_AGENT_ALLOWED_EMAIL=
VAULT_AGENT_CANONICAL_URL=https://khora-web.vercel.app

# EP-only password gate; generate verifier values with scripts/generate-ep-master-verifier.mjs.
EP_MASTER_PASSWORD_SALT=
EP_MASTER_PASSWORD_HASH=
EP_MASTER_SESSION_SECRET=
EP_MASTER_SESSION_TTL_SECONDS=900

# GitHub App installed only on the approved EP repositories.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
