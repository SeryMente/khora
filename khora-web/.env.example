EP_BOOTSTRAP_JWT_SECRET=
EP_CANONICAL_URL=https://khora.example.com/api/ep
EP_ALLOWED_EMAIL=
EP_TOKEN_TTL_SECONDS=43200

# Capacidad de 60 minutos emitida por Khora Web para el agente local.
VAULT_AGENT_ALLOWED_EMAIL=
VAULT_AGENT_CANONICAL_URL=https://khora-web.vercel.app
# Backblaze B2 Native API. Use only KHORA account Master Application Key; server environment only.
# Existing Vercel names KHORA_B2_KEY_ID / KHORA_B2_APPLICATION_KEY remain a compatibility fallback.
# Runtime preflight proves that the configured key is genuinely the Master Key; it never logs values.
KHORA_B2_MASTER_APPLICATION_KEY_ID=
KHORA_B2_MASTER_APPLICATION_KEY=
KHORA_B2_BUCKET_NAME=
KHORA_B2_BUCKET_ID=
KHORA_B2_REGION=us-east-005
KHORA_OBJECT_STORAGE=b2
KHORA_B2_PREFLIGHT=1
