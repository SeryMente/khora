# === Demiurgo · modulo globo · secretos (NUNCA en el codigo; van por GitHub Secrets) ===
# v3.32 tenia el token de Notion HARDCODEADO en background.js. En nube se externaliza.
NOTION_TOKEN=ntn_xxx_pon_tu_token_de_integracion

# Base «Llamadas · GLOBO» (UUID). v3.32: 69b2a69b-e923-4c0f-b438-f38b0cd35b95
GLOBO_CALLS_DB_ID=69b2a69b-e923-4c0f-b438-f38b0cd35b95

# --- SESION GLOBO (dependencia dura #1) ---
# El portal exige sesion logueada. En la extension la cookie la ponia el navegador.
# En nube hay dos caminos (ver README):
#  (A) COOKIE directa capturada de una sesion valida (fragil, expira):
GLOBO_COOKIE=
#  (B) credenciales para un login headless (Playwright) que renueva la cookie sola:
GLOBO_USER=
GLOBO_PASS=

# Cadencia del sondeo (min). v3.32 = 2.
GLOBO_POLL_MIN=2

# Tipo de cambio MXN/USD para los logs de dinero. ACTUALIZAR en vivo (v3.32 fijaba 17.28).
GLOBO_TC=17.34

# Ejecutor local para ACCIONES de llamada (dependencia dura #2). URL del agente local.
# Si se deja vacio, las acciones de llamada quedan deshabilitadas (NO se simulan).
GLOBO_LOCAL_EXECUTOR_URL=
