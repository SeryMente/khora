{
  "schema": "harmonia.coverage-catalog.v1",
  "version": "0.1.3",
  "reviewedAt": "2026-11-11",
  "title": "Inventario estructural de la interfaz de ChatGPT en Chrome",
  "purpose": "Medir el grado de mapeo documental y observacional de la interfaz, incluidas regiones de navegación y superficies auxiliares. El catálogo no afirma captura de contenido ni completitud del comportamiento.",
  "scope": {
    "include": [
      "vista principal de conversación",
      "mensajes del usuario y del asistente",
      "compositor y controles inmediatos",
      "estados de generación",
      "bloques y resultados dentro de la conversación",
      "citas y resultados de herramientas visibles en el hilo",
      "regiones estructurales de navegación y barra lateral",
      "menús, listas de opciones, diálogos y popovers mediante atributos estructurales allowlisted",
      "selectores de modelo y herramientas mediante metadatos estructurales"
    ],
    "exclude": [
      "Configuración y preferencias de cuenta",
      "Chrome y sus menús",
      "red interna de la plataforma",
      "razonamiento privado no expuesto por la interfaz",
      "texto visible de navegación, títulos de conversaciones, contenido de menús o diálogos",
      "valores de controles, datos de cuenta y contenido privado de superficies emergentes"
    ]
  },
  "scoring": {
    "documentationWeight": 1,
    "naturalObservationWeight": 1,
    "formula": "100 * (featuresWithOfficialDocumentation + featuresObservedInNaturalNavigation) / (2 * inScopeFeatures)",
    "interpretation": "Índice de completitud del mapeo, no de la aplicación ni de la calidad de captura. Mostrar además ambos componentes y los elementos pendientes por clasificar."
  },
