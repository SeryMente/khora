{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harmonia.binomial-benchmark-dataset.v1",
  "title": "Harmonia Binomial Benchmark Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "protocol_version", "benchmark_id", "state", "cases", "pairs"],
  "properties": {
    "schema": { "const": "harmonia.binomial-benchmark-dataset.v1" },
    "protocol_version": { "const": "1.0" },
    "benchmark_id": { "const": "BENCH-GROQ-001" },
    "state": { "enum": ["design_ready_data_pending", "running", "complete", "insufficient_evidence"] },
    "cases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "status", "omm_id", "task_class", "evidence_class", "evidence_sha256", "snapshot_sha256", "contract_sha256", "verified_root_cause"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^CASE-0[1-5]$" },
          "status": { "enum": ["unselected", "selected", "verified", "excluded"] },
          "omm_id": { "type": ["string", "null"] },
          "task_class": { "type": ["string", "null"] },
          "evidence_class": { "enum": ["natural_observation", "reproducible_real_issue", null] },
          "evidence_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
          "snapshot_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
          "contract_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
          "verified_root_cause": { "type": ["string", "null"] }
        }
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair_id", "case_id", "repetition", "evidence_sha256", "snapshot_sha256", "contract_sha256", "baseline", "binomial", "verification"],
        "properties": {
          "pair_id": { "type": "string", "pattern": "^PAIR-[0-9]{2}-R[1-2]$" },
          "case_id": { "type": "string", "pattern": "^CASE-0[1-5]$" },
          "repetition": { "type": "integer", "minimum": 1, "maximum": 2 },
          "evidence_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "snapshot_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "contract_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "baseline": { "$ref": "#/$defs/run" },
          "binomial": { "$ref": "#/$defs/run" },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root_cause_verified", "paired_inputs_equal", "record_reviewed", "verified_by"],
            "properties": {
              "root_cause_verified": { "type": "boolean" },
              "paired_inputs_equal": { "type": "boolean" },
              "record_reviewed": { "type": "boolean" },
              "verified_by": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_path", "chatgpt_model", "groq_model", "codex_version", "diagnosis_code", "scenario_id", "diagnosis_correct", "local_confidence", "local_decision", "groq_invoked", "groq_latency_ms", "accepted", "critical_regressions", "unique_actionable_findings", "accepted_unique_findings", "false_positives", "unsupported_claims", "iterations", "analysis_ms", "codex_ms", "total_ms", "input_tokens", "output_tokens", "chatgpt_input_tokens", "chatgpt_output_tokens", "groq_input_tokens", "groq_output_tokens", "codex_input_tokens", "codex_output_tokens", "groq_cost_usd", "codex_cost_usd", "cost_usd", "tests_before_passed", "tests_after_passed", "tests_after_failed", "regressions"],
      "properties": {
        "provider_path": { "enum": ["chatgpt_local_codex", "chatgpt_groq_codex"] },
        "chatgpt_model": { "type": ["string", "null"] },
        "groq_model": { "type": ["string", "null"] },
        "codex_version": { "type": ["string", "null"] },
        "diagnosis_code": { "type": ["string", "null"] },
        "scenario_id": { "type": ["string", "null"] },
        "diagnosis_correct": { "type": ["boolean", "null"] },
        "local_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "local_decision": { "enum": ["local_deterministic", "groq_analysis", "collect_more_evidence", "local_fallback", "operator_review", null] },
        "groq_invoked": { "type": "boolean" },
        "groq_latency_ms": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "boolean" },
        "critical_regressions": { "type": "integer", "minimum": 0 },
        "unique_actionable_findings": { "type": "integer", "minimum": 0 },
        "accepted_unique_findings": { "type": "integer", "minimum": 0 },
        "false_positives": { "type": "integer", "minimum": 0 },
        "unsupported_claims": { "type": "integer", "minimum": 0 },
        "iterations": { "type": "integer", "minimum": 0 },
        "analysis_ms": { "type": "integer", "minimum": 0 },
        "codex_ms": { "type": "integer", "minimum": 0 },
        "total_ms": { "type": "integer", "minimum": 0 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "chatgpt_input_tokens": { "type": "integer", "minimum": 0 },
        "chatgpt_output_tokens": { "type": "integer", "minimum": 0 },
        "groq_input_tokens": { "type": "integer", "minimum": 0 },
        "groq_output_tokens": { "type": "integer", "minimum": 0 },
        "codex_input_tokens": { "type": "integer", "minimum": 0 },
        "codex_output_tokens": { "type": "integer", "minimum": 0 },
        "groq_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "codex_cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 },
        "tests_before_passed": { "type": "integer", "minimum": 0 },
        "tests_after_passed": { "type": "integer", "minimum": 0 },
        "tests_after_failed": { "type": "integer", "minimum": 0 },
        "regressions": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
