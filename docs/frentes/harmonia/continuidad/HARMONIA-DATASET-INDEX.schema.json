                                                                                                "type":  [
                                                                                                             "string",
                                                                                                             "null"
                                                                                                         ]
                                                                                            },
                                                                                     "A":  {
                                                                                               "type":  [
                                                                                                            "string",
                                                                                                            "null"
                                                                                                        ]
                                                                                           },
                                                                                     "B":  {
                                                                                               "type":  [
                                                                                                            "string",
                                                                                                            "null"
                                                                                                        ]
                                                                                           },
                                                                                     "state":  {
                                                                                                   "const":  "FOL1_PREPARADO_PENDIENTE_ACTIVACION"
                                                                                               }
