                                                  "readback_verified_at":  {
                                                                               "type":  [
                                                                                            "string",
                                                                                            "null"
                                                                                        ],
                                                                               "format":  "date-time"
                                                                           }
                                              }
                           },
                  "missing_source":  {
                                         "type":  "object",
                                         "additionalProperties":  false,
                                         "required":  [
                                                          "label",
                                                          "status",
                                                          "reason",
                                                          "source_ref"
                                                      ],
                                         "properties":  {
                                                            "label":  {
                                                                          "type":  "string"
