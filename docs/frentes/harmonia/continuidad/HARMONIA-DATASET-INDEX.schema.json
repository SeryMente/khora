                                                                                  "string",
                                                                                  "null"
                                                                              ]
                                                                 },
                                                  "sha256":  {
                                                                 "type":  [
                                                                              "string",
                                                                              "null"
                                                                          ],
                                                                 "pattern":  "^[A-Fa-f0-9]{64}$"
