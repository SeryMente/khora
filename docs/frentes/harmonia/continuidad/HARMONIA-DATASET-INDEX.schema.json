{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "$id":  "harmonia-conversation-cycle-index-v1",
    "title":  "Harmonia Ã‚Â· ÃƒÂ­ndice de metadatos de conversaciÃƒÂ³n y ciclo",
