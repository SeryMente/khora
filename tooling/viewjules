with open(_pidfile, "w") as _pf:
    _pf.write(str(os.getpid()))
import atexit
atexit.register(lambda: os.path.exists(_pidfile) and os.remove(_pidfile))


SHOW_ALL = "--all" in ARGS
CLEAR = "--clear" in ARGS
MUTE_APPROVE = "--mute-approve" in ARGS
COLOR_ON = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None and "--no-color" not in ARGS
LAST_N = 5
if "--last" in ARGS:
    try: LAST_N = max(1, int(ARGS[ARGS.index("--last") + 1]))
    except Exception: pass

def c(code, text):
    return code + text + RESET if COLOR_ON else text

def link(url, label=None):
    if not url: return ""
    label = label or url
    if not COLOR_ON: return url
    return "\033]8;;" + url + "\033\\" + label + "\033]8;;\033\\"

ICON = {"QUEUED":"🕐","PLANNING":"🧠","AWAITING_PLAN_APPROVAL":"🟡","AWAITING_USER_FEEDBACK":"🙋",
        "IN_PROGRESS":"⚙️ ","PAUSED":"⏸","FAILED":"💥","COMPLETED":"🎉","STATE_UNSPECIFIED":"❔"}
STAGE_LABEL = {"QUEUED":"en cola","PLANNING":"planificando","AWAITING_PLAN_APPROVAL":"por aprobar",
               "IN_PROGRESS":"codificando","AWAITING_USER_FEEDBACK":"te preguntan","PAUSED":"en pausa"}
MSG = {"QUEUED":"en cola, esperando su turno","PLANNING":"Jules está armando el plan",
       "AWAITING_PLAN_APPROVAL":"plan listo, por aprobar","AWAITING_USER_FEEDBACK":"Jules te hizo una pregunta — revisa",
       "IN_PROGRESS":"escribiendo código","PAUSED":"en pausa","FAILED":"la sesión falló","COMPLETED":"terminada",
       "STATE_UNSPECIFIED":"sin estado"}
PCT = {"QUEUED":5,"PLANNING":20,"AWAITING_PLAN_APPROVAL":35,"AWAITING_USER_FEEDBACK":45,
       "IN_PROGRESS":70,"PAUSED":50,"FAILED":100,"COMPLETED":100,"STATE_UNSPECIFIED":0}
BLOCKS = " ▏▎▍▌▋▊▉█"

def bar_color(st, done, has_pr):
    if done and has_pr: return GREEN
    if st == "FAILED": return RED
    if st == "AWAITING_USER_FEEDBACK": return MAGENTA
    if st == "AWAITING_PLAN_APPROVAL": return YELLOW
    if st == "IN_PROGRESS": return CYAN
    if st == "PAUSED": return GRAY
    return BLUE

def dbar(p, w=18):
    p = max(0, min(100, p))
    eighths = round(p / 100 * w * 8)
    full, rem = divmod(eighths, 8)
    if full >= w: return "█" * w
    return "█"*full + BLOCKS[rem] + "░"*(w-full-1)

def load_reg():
    try:
        with open(REG) as f: return json.load(f)
    except Exception: return {}

def save_reg(r):
    try:
        with open(REG, "w") as f: json.dump(r, f, indent=1)
    except Exception: pass

def api(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BASE + path, data=data,
        headers={"x-goog-api-key": KEY, "Content-Type": "application/json"}, method=method)
    try:
        with urllib.request.urlopen(req, timeout=30) as r: return json.load(r), None
    except urllib.error.HTTPError as e: return None, "HTTP " + str(e.code) + ": " + e.read().decode()[:80]
    except Exception as e: return None, str(e)[:80]

def list_all_sessions():
    out = []; token = ""
    for _ in range(20):
        q = "pageSize=100" + ("&pageToken=" + urllib.parse.quote(token) if token else "")
        d, e = api("GET", "/sessions?" + q)
        if d is None: return out, e
        out.extend(d.get("sessions", []))
        token = d.get("nextPageToken", "")
        if not token: break
    return out, None

def pr_links_from_session(sid):
    d, e = api("GET", "/sessions/" + sid)
    if not d: return []
    out = []
    for o in d.get("outputs", []) or []:
        pr = o.get("pullRequest")
        if pr and pr.get("url"): out.append(pr["url"])
    return out

def pr_label(url):
    m = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/(\d+)", url)
    return (m.group(1) + " #" + m.group(2)) if m else url

def short(sid): return sid[:4] + "…" + sid[-4:] if len(sid) > 10 else sid

def parse_ts(s):
    if not s: return None
    try:
        s2 = re.sub(r"(\.\d{1,6})\d*Z$", r"\1+00:00", s)
        if s2.endswith("Z"): s2 = s2[:-1] + "+00:00"
        return datetime.datetime.fromisoformat(s2)
    except Exception:
        return None

def since_secs(ts):
    dt = parse_ts(ts)
    if dt is None: return None
    return max(0, int((datetime.datetime.now(datetime.timezone.utc) - dt).total_seconds()))

def human(secs):
    if secs is None: return "?"
    h, rem = divmod(secs, 3600); m, s = divmod(rem, 60)
    if h: return "%dh%02dm" % (h, m)
    if m: return "%dm%02ds" % (m, s)
    return "%ds" % s

def freshness(update_ts):
    secs = since_secs(update_ts)
    if secs is None: return DIM, "?"
    if secs < 120: return GREEN, human(secs)
    if secs < 600: return YELLOW, human(secs)
    return RED, human(secs)

KHORA_STATUS_PATH = os.path.expanduser("~/.khora_status.json")
KHORA_INTERVAL_SECS = 150
KHORA_LOG_PATH = os.path.expanduser("~/.khora_ok.log")
_ANSI_RE = re.compile(r"\x1b\[[0-9;]*m|\x1b\]8;;.*?\x1b\\")

def visible_len(s):
    return len(_ANSI_RE.sub("", s))

def clip(s, width):
    if width <= 0 or visible_len(s) <= width:
        return s
    out = []; vis = 0; i = 0; n = len(s)
    while i < n:
        m = _ANSI_RE.match(s, i)
        if m:
            out.append(m.group(0)); i = m.end(); continue
        if vis >= width:
            break
        out.append(s[i]); vis += 1; i += 1
    out.append(RESET)
    return "".join(out)

def load_khora_status():
    try:
        with open(KHORA_STATUS_PATH) as f: return json.load(f)
    except Exception:
        return None

def maybe_trigger_khora():
    st = load_khora_status()
    now = datetime.datetime.now(datetime.timezone.utc)
    if st and st.get("running"):
        return
    last_ts = parse_ts(st.get("updated") or st.get("started")) if st else None
    if last_ts is not None and (now - last_ts).total_seconds() < KHORA_INTERVAL_SECS:
        return
    try:
        with open(KHORA_LOG_PATH, "a") as logf:
            subprocess.Popen(["bash", "-ic", "khora-ok"], stdout=logf, stderr=subprocess.STDOUT,
                              stdin=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass

def _append_khora_lines(lines, bar, sep):
    st = load_khora_status()
    lines.append(sep)
    if not st:
        lines.append(bar + c(BOLD, "🛰  KHORA-OK") + "  " + c(DIM, "sin datos todavía (aún no corrió)"))
        return
    phase = st.get("phase", 0) or 0
    total = st.get("total", 5) or 5
    pct = st.get("pct", 0) or 0
    label = st.get("label", "") or ""
    running = st.get("running", False)
    result = st.get("result")
    sub_label = st.get("sub_label")
    sub_pct = st.get("sub_pct")
    updated = st.get("updated")
    finished = st.get("finished")
    if running:
        status_txt = c(CYAN, "⚙️  corriendo"); bcol = CYAN
    elif result == "ok":
        status_txt = c(GREEN, "✅ última corrida OK"); bcol = GREEN
    elif result == "fail":
        status_txt = c(RED, "❌ última corrida FALLÓ"); bcol = RED
    else:
        status_txt = c(DIM, "❔ sin resultado"); bcol = BLUE
    when_ts = finished if (not running and finished) else updated
    when_secs = since_secs(when_ts) if when_ts else None
    when_txt = human(when_secs) if when_secs is not None else "?"
    lines.append(bar + c(BOLD, "🛰  KHORA-OK") + "  " + status_txt + "  " + c(DIM, "hace " + when_txt))
    lines.append(bar + "   " + c(bcol, dbar(pct)) + " " + c(bcol, "%3d%%" % pct) + "  fase " + str(phase) + "/" + str(total) + "  " + c(DIM, label))
    if running and sub_label:
        try: sp = int(sub_pct) if sub_pct is not None else 0
        except Exception: sp = 0
        lines.append(bar + "   " + c(DIM, "└─ " + str(sub_label) + " ") + c(CYAN, dbar(sp, 12)) + c(DIM, " %3d%%" % sp))
    if not running and when_secs is not None:
        remaining = max(0, KHORA_INTERVAL_SECS - when_secs)
        lines.append(bar + "   " + c(DIM, "⏳ próxima corrida en " + human(remaining)))

reg = load_reg()
if CLEAR:
    reg = {k: v for k, v in reg.items() if not v.get("done")}
    save_reg(reg)
    print("🧹 registro limpiado, " + str(len(reg)) + " sesion(es) conservadas")

lat = {}
first = True; tick = 0; maxNL = 0
try:
    while True:
        sessions, list_err = list_all_sessions()
        if list_err and not sessions:
            sys.stdout.write("\r\033[K⚠ No pude listar sesiones: " + list_err + "\n")
            time.sleep(6); tick += 1; continue
        for sd in sessions:
            sid = sd.get("id") or sd.get("name", "").split("/")[-1]
            if not sid: continue
            info = reg.setdefault(sid, {"title": sid, "done": False, "ap": False, "prs": []})
            info["title"] = sd.get("title", info.get("title", sid))
            info["session_url"] = sd.get("url", info.get("session_url", ""))
            info["createTime"] = sd.get("createTime", info.get("createTime", ""))
            info["updateTime"] = sd.get("updateTime", info.get("updateTime", ""))
            st = str(sd.get("state", "")).upper(); info["state"] = st
            if st in DONE_STATES: info["done"] = True
            reg[sid] = info
        for sid, info in list(reg.items()):
            if info.get("done"):
                if not info.get("_outputs_checked"):
                    info["prs"] = pr_links_from_session(sid)
                    info["_outputs_checked"] = True
                reg[sid] = info
                continue
            ad, e2 = api("GET", "/sessions/" + sid + "/activities?pageSize=10")
            acts = (ad or {}).get("activities", [])
            if acts:
                last = acts[-1]
                d = last.get("description") or last.get("agentMessage") or last.get("userMessage") or ""
                lat[sid] = (d.splitlines()[0] if d else "actividad")[:52]
            st = info.get("state", "")
            if not MUTE_APPROVE and not info.get("ap") and st == "AWAITING_PLAN_APPROVAL":
                ar, ae = api("POST", "/sessions/" + sid + ":approvePlan", {})
                if ar is not None:
                    info["ap"] = True; lat[sid] = "plan aprobado ✓ — codificando..."
            reg[sid] = info
        save_reg(reg)

        if not MUTE_APPROVE:
            for _sid, _info in reg.items():
                if _info.get("done") or _info.get("state") != "AWAITING_USER_FEEDBACK":
                    _info["needs_human"] = False
                    continue
                _fb = _info.get("fb_replies", 0)
                _last = lat.get(_sid, "")
                _lw = _last.lower()
                _kw = ["apruebas", "apruebo", "procedo", "continuo", "confirmar", "autorizas", "de acuerdo", "ok", "si/no", "correcto"]
                _simple = bool(_last) and (len(_last) < 260 or any(k in _lw for k in _kw))
                if _simple and _fb < 2:
                    _fr, _fe = api("POST", "/sessions/" + _sid + ":sendMessage", {"prompt": "Sin preguntas adicionales: procede con la opcion mas simple que cumpla el HECHO CUANDO de la tarjeta, documentada en el PR."})
                    if _fr is not None:
                        _info["fb_replies"] = _fb + 1
                        lat[_sid] = "pregunta simple -> auto-respondida"
                        _info["needs_human"] = False
                else:
                    _info["needs_human"] = True
        save_reg(reg)

        active_ids = [sid for sid, info in reg.items() if not info.get("done")]
        active_ids.sort(key=lambda sid: (0 if reg[sid].get("state") == "AWAITING_USER_FEEDBACK" else
                                          1 if reg[sid].get("state") == "IN_PROGRESS" else
                                          2 if reg[sid].get("state") == "AWAITING_PLAN_APPROVAL" else
                                          3 if reg[sid].get("state") == "PLANNING" else
                                          4 if reg[sid].get("state") == "QUEUED" else 5))
        done_ids = [sid for sid, info in reg.items() if info.get("done")]
        done_ids.sort(key=lambda sid: reg[sid].get("updateTime", ""), reverse=True)
        done_shown = done_ids if SHOW_ALL else done_ids[:LAST_N]

        stage_counts = {s: 0 for s in STAGES}
        for sid in active_ids:
            st = reg[sid].get("state", "")
            if st in stage_counts: stage_counts[st] += 1
        done_total = len(done_ids)
        with_pr = [sid for sid in done_ids if reg[sid].get("prs")]
        durs = []
        for sid in done_ids:
            a, b = parse_ts(reg[sid].get("createTime","")), parse_ts(reg[sid].get("updateTime",""))
            if a and b: durs.append(max(0, int((b-a).total_seconds())))
        avg_dur = human(int(sum(durs)/len(durs))) if durs else "?"

        fr = SPIN[tick % len(SPIN)]
        now_str = time.strftime("%H:%M:%S")
        top = c(CYAN, "╔" + "═"*FRAME_W + "╗")
        sep = c(CYAN, "╠" + "═"*FRAME_W + "╣")
        bot = c(CYAN, "╚" + "═"*FRAME_W + "╝")
        bar = c(CYAN, "║ ")

        pipeline1 = "  ".join(c(BLUE if stage_counts[s]==0 else CYAN, ICON[s]+" "+STAGE_LABEL[s]+"·"+str(stage_counts[s])) for s in STAGES[:3])
        pipeline2 = "  ".join(c(BLUE if stage_counts[s]==0 else CYAN, ICON[s]+" "+STAGE_LABEL[s]+"·"+str(stage_counts[s])) for s in STAGES[3:])
        pipeline2 += "   " + c(GRAY,"→") + "   " + c(GREEN, "🏁 terminadas·"+str(done_total))

        lines = [top,
                 bar + c(BOLD, "👁  VIEWJULES") + "  " + c(DIM, now_str + " " + fr),
                 bar + pipeline1,
                 bar + pipeline2,
                 sep,
                 bar + c(BOLD, "🚀 EN CURSO") + c(DIM, " (" + str(len(active_ids)) + ")"),
                 bar]
        if not active_ids:
            lines.append(bar + c(DIM, "🌤  nada corriendo ahora mismo"))
        for sid in active_ids:
            info = reg[sid]; st = info.get("state", "")
            bc = bar_color(st, False, False)
            pct = PCT.get(st, 10)
            title_txt = str(info.get("title", sid))[:40]
            lines.append(bar + ICON.get(st, "❔") + "  " + c(BOLD, title_txt) + "  " + c(DIM, "(" + short(sid) + ")"))
            lines.append(bar + "   " + c(bc, dbar(pct)) + " " + c(bc, "%3d%%" % pct) +
                         "  ⏱ " + c(DIM, human(since_secs(info.get("createTime","")))) +
                         "  " + c(DIM, MSG.get(st, st or "?")))
            fcol, flabel = freshness(info.get("updateTime", ""))
            sub = ["💬 " + c(DIM, lat.get(sid, "esperando primer dato..."))]
            if info.get("needs_human") and st == "AWAITING_USER_FEEDBACK":
                sub.append(c(MAGENTA, "🧩 atorado con feedback complejo hace " + flabel + " — necesita tu respuesta real"))
            if fcol == RED:
                sub.append(c(RED, "⚠ sin novedades hace " + flabel + " — quizás valga revisar"))
            if info.get("session_url"): sub.append("🔗 " + link(info["session_url"], "abrir sesión ↗"))
            for i, s in enumerate(sub):
                branch = "└─ " if i == len(sub)-1 else "├─ "
                lines.append(bar + "   " + c(DIM, branch) + s)
            lines.append(bar)

        lines.append(sep)
        head_done = c(BOLD, "🏁 ÚLTIMAS TERMINADAS")
        if not SHOW_ALL and done_total > LAST_N:
            head_done += c(DIM, "  (" + str(LAST_N) + " de " + str(done_total) + " · --all para todas)")
        lines.append(bar + head_done)
        lines.append(bar)
        if not done_shown:
            lines.append(bar + c(DIM, "(todavía ninguna)"))
        for sid in done_shown:
            info = reg[sid]; prs = info.get("prs", [])
            title_txt = str(info.get("title", sid))[:38].ljust(38)
            when = human(since_secs(info.get("updateTime",""))).rjust(7)
            icon = "🎉" if prs else "✔️ "
            pr_txt = link(prs[0], pr_label(prs[0]) + " ↗") if prs else c(DIM, "sin PR")
            extra = c(DIM, " +%d" % (len(prs)-1)) if len(prs) > 1 else ""
            lines.append(bar + icon + " " + c(DIM, "hace " + when) + "   " + c(BOLD, title_txt) + "  " + c(GREEN, pr_txt) + extra)

        lines.append(sep)
        lines.append(bar + c(DIM, "📈 en tu registro: " + str(done_total) + " terminadas · " + str(len(with_pr)) +
                              " con PR · promedio " + avg_dur + " por tarea"))
        lines.append(bot)

        COLS = shutil.get_terminal_size((80, 24)).columns
        maybe_trigger_khora()
        _append_khora_lines(lines, bar, sep)
        NL = len(lines); pad = max(0, maxNL - NL); maxNL = max(maxNL, NL)
        if not first: sys.stdout.write("\033[" + str(maxNL) + "A")
        first = False
        for ln in lines: sys.stdout.write("\r\033[K" + clip(ln, COLS - 1) + "\n")
        for _ in range(pad): sys.stdout.write("\r\033[K\n")
        sys.stdout.flush()
        tick += 1; time.sleep(6)
except KeyboardInterrupt:
    save_reg(reg); print("\n⏹  viewjules detenido (memoria guardada)."); sys.exit(0)
