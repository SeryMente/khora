#!/usr/bin/env python3
"""viewjules v7 — HUD de pipeline Jules: panel completo, barras finas, detección de estancamiento, stats reales."""
import os, sys, json, time, re, datetime, urllib.request, urllib.error, urllib.parse, subprocess, shutil

KEY = os.environ.get("JULES_API_KEY", "")
BASE = "https://jules.googleapis.com/v1alpha"
REG = os.path.expanduser("~/.jules_sessions.json")
SPIN = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
DONE_STATES = {"COMPLETED", "FAILED"}
STAGES = ["QUEUED", "PLANNING", "AWAITING_PLAN_APPROVAL", "IN_PROGRESS", "AWAITING_USER_FEEDBACK", "PAUSED"]
FRAME_W = 66

RESET, BOLD, DIM = "\033[0m", "\033[1m", "\033[2m"
CYAN, GREEN, YELLOW, RED, MAGENTA, BLUE, GRAY = "\033[36m","\033[32m","\033[33m","\033[31m","\033[35m","\033[34m","\033[90m"

ARGS = sys.argv[1:]
if "--help" in ARGS or "-h" in ARGS:
    print("uso: viewjules [--all] [--last N] [--clear] [--mute-approve] [--no-color]\n"
          "  sin args        -> panel: pipeline en vivo + últimas 5 terminadas + stats, sin SIDs\n"
          "  --last N        -> muestra las últimas N terminadas en vez de 5\n"
          "  --all           -> muestra TODO el historial de terminadas, sin límite\n"
          "  --clear         -> olvida del registro local las ya terminadas\n"
          "  --mute-approve  -> solo observa, no auto-aprueba planes\n"
          "  --no-color      -> salida en texto plano, sin color ni hipervínculos")
    sys.exit(0)
if not KEY:
    print("✗ Falta JULES_API_KEY"); sys.exit(1)
_pidfile = os.path.expanduser("~/.viewjules.pid")
_running_pid = None
try:
    with open(_pidfile) as _pf:
        _running_pid = int(_pf.read().strip())
    os.kill(_running_pid, 0)
except Exception:
    _running_pid = None
if _running_pid:
    print("Ya hay un viewjules corriendo (pid " + str(_running_pid) + ") - no arranco otro.")
