{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:khora:corpus-autobiografico:schema:0.1.0",
  "title": "Unidad del corpus autobiográfico de Khora 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "corpus_id",
    "unit_id",
    "revision",
    "subject",
    "source",
    "anchor",
    "content",
    "modality",
    "eligibility",
    "event_time",
    "captured_at",
    "review",
    "governance",
    "derivation"
  ],
  "properties": {
    "contract_id": {
      "const": "khora.corpus-autobiografico",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "type": "string"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
    },
    "unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attribution"
      ],
      "properties": {
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "attribution": {
          "type": "string",
          "enum": [
            "explicit",
            "supported",
            "ambiguous",
            "rejected"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "revision",
        "sha256",
        "occurrence_id",
        "channel",
        "medium",
        "representation",
        "integrity"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "occurrence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "medium": {
          "type": "string",
          "enum": [
            "text",
            "audio",
            "video",
            "image",
            "document"
          ]
        },
        "representation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "integrity": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "failed"
          ]
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinates",
        "start",
        "end"
      ],
      "properties": {
        "coordinates": {
          "type": "string",
          "enum": [
            "utf16",
            "unicode_codepoints",
            "bytes",
            "milliseconds",
            "whole_resource"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        }
      }
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "modality": {
      "type": "string",
      "enum": [
        "self_report",
        "uncertain_memory",
        "observation",
        "quotation",
        "desire",
        "hypothesis",
        "system_inference"
      ]
    },
    "eligibility": {
      "type": "string",
      "enum": [
        "candidate",
        "pertinent",
        "excluded",
        "disputed"
      ]
    },
    "event_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "known",
            "unknown",
            "not_captured",
            "unavailable",
            "denied",
            "not_applicable"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "expressed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z(?![\\s\\S])"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z(?![\\s\\S])"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z(?![\\s\\S])"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unreviewed",
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "actor_kind": {
          "type": "string",
          "enum": [
            "human",
            "system"
          ]
        },
        "actor_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "decided_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z(?![\\s\\S])"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_ref",
        "policy_ref",
        "policy_revision",
        "sensitivity",
        "retention",
        "retention_policy_ref"
      ],
      "properties": {
        "owner_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sensitivity": {
          "type": "string",
          "enum": [
            "private",
            "restricted"
          ]
        },
        "retention": {
          "type": "string",
          "enum": [
            "temporary",
            "retained",
            "deleting",
            "withdrawn"
          ]
        },
        "retention_policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z(?![\\s\\S])"
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_ref",
        "pipeline_version",
        "policy_ref"
      ],
      "properties": {
        "generation_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "pipeline_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "model_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*(?![\\s\\S])"
        }
      }
    }
  }
}
